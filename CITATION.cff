    value: "10.5281/zenodo.24015201"
    description: "Archived release 0.2.0 (before the sealed test)"
repository-code: "https://github.com/sahilprg/gnss-interference"
url: "https://sahilprg.github.io/gnss-interference/"
license: MIT
version: "0.2.0"
doi: "10.5281/zenodo.24015201"
date-released: "2026-11-06"
keywords:
  - GNSS
  - GPS jamming
  - GPS spoofing
  - ADS-B
  - weak supervision
  - aviation safety
  - pre-registration
